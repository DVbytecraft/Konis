# KONIS V0 - Variables d'environnement (copier en .env, NE JAMAIS commiter .env)
# ==============================================================================

# -- Base de données --
# Dev Docker Compose (port hôte 5433 pour éviter les conflits locaux)
DATABASE_URL=postgres://konis_user:konis_password@localhost:5433/konis_db

# -- Django --
DJANGO_SETTINGS_MODULE=konis.settings.dev
# En production : konis.settings.prod

# -- Sécurité (OBLIGATOIRE en production) --
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-change-in-prod-CHANGE_ME

# -- Hôtes autorisés (OBLIGATOIRE en production) --
# Séparés par virgule : konis-api.onrender.com,mondomaine.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -- CORS : origines frontend autorisées (OBLIGATOIRE en production) --
# Séparées par virgule : https://mon-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
