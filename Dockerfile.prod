# ============================================================
# KONIS — Dockerfile de production (backend Django/Gunicorn)
# Image multi-stage : build deps séparées de l'image finale.
# ============================================================

# ---- Stage 1 : installation des dépendances ----
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ---- Stage 2 : image finale légère ----
FROM python:3.12-slim

WORKDIR /app

# libpq5 = runtime PostgreSQL uniquement (pas les headers de dev, -dev non nécessaire ici).
# curl = utilisé par le HEALTHCHECK docker natif.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copier uniquement les packages installés (pas gcc, pas build tools)
COPY --from=builder /install /usr/local

# Copier le code source (hors frontend, node_modules, etc. via .dockerignore)
COPY . .

# Copier et rendre exécutable l'entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Utilisateur non-root pour la sécurité
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8000

# Healthcheck natif Docker : vérifie que Gunicorn répond sur /api/health/
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
