# EditorConfig — https://editorconfig.org
# Garantit UTF-8 + LF + indentation cohérente pour tous les éditeurs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
