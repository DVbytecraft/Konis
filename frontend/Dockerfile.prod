# ============================================================
# KONIS — Dockerfile de production (frontend Next.js)
# Multi-stage : build séparé de l'image finale légère.
# Utilise le mode "standalone" de Next.js.
# ============================================================

# ---- Stage 1 : build ----
FROM node:20-alpine AS builder

WORKDIR /app

# Installer les dépendances
# --legacy-peer-deps : tolère les conflits de peer deps (vite/vitest/react)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copier le code source
COPY . .

# Désactiver la télémétrie Next.js
ENV NEXT_TELEMETRY_DISABLED=1

# Build de production (génère .next/standalone/)
RUN npm run build


# ---- Stage 2 : image finale minimale ----
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Utilisateur non-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copier uniquement les artefacts du build standalone
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# server.js généré par Next.js standalone
CMD ["node", "server.js"]
