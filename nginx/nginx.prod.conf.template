# ============================================================
# KONIS — Nginx configuration PRODUCTION avec HTTPS (Let's Encrypt)
#
# Ce fichier est un template : $DOMAIN est substitué par envsubst
# au démarrage du conteneur nginx (mécanisme nginx:alpine templates).
#
# Pour forcer la regen : docker compose restart nginx
# ============================================================

# ── Rate limiting zones (dans le bloc http, via include conf.d/) ──────────────
# 60 req/min par IP pour l'API générale (burst 20 sans délai)
limit_req_zone $binary_remote_addr zone=api_global:10m rate=60r/m;
# 10 req/min par IP pour login/refresh (anti brute-force, burst 5 sans délai)
limit_req_zone $binary_remote_addr zone=api_auth:10m   rate=10r/m;

# ── Upstreams ─────────────────────────────────────────────────────────────────
upstream backend {
    server backend:8000;
    keepalive 32;
}

upstream frontend {
    server frontend:3000;
    keepalive 32;
}

# ══════════════════════════════════════════════════════════════════════════════
# Serveur HTTP (port 80) : uniquement pour ACME challenge + redirection HTTPS
# ══════════════════════════════════════════════════════════════════════════════
server {
    listen      80;
    server_name ${DOMAIN};

    # Challenge Let's Encrypt (ACME webroot method)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Redirection permanente HTTP → HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ══════════════════════════════════════════════════════════════════════════════
# Serveur HTTPS (port 443)
# ══════════════════════════════════════════════════════════════════════════════
server {
    listen      443 ssl;
    http2       on;
    server_name ${DOMAIN};

    # ── Certificats SSL (Let's Encrypt via Certbot) ───────────────────────────
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;

    # ── Protocoles et chiffrement (Mozilla Intermediate — compatible TLS 1.2+) ─
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;

    # ── Session SSL ───────────────────────────────────────────────────────────
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;

    # ── OCSP Stapling (réduit la latence de vérification du cert) ─────────────
    ssl_stapling        on;
    ssl_stapling_verify on;
    resolver            8.8.8.8 1.1.1.1 valid=300s;
    resolver_timeout    5s;

    # ── En-têtes de sécurité globaux ──────────────────────────────────────────
    # HSTS : force HTTPS pour 1 an, tous sous-domaines, préchargement navigateur
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options            "DENY"                              always;
    add_header X-Content-Type-Options     "nosniff"                           always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin"   always;
    add_header X-XSS-Protection           "1; mode=block"                     always;
    add_header Permissions-Policy         "camera=(), microphone=(), geolocation=()" always;

    # ── Limites de requête ────────────────────────────────────────────────────
    client_max_body_size 20M;

    # ── Timeouts proxy ────────────────────────────────────────────────────────
    proxy_connect_timeout  60s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    # ── En-têtes proxy communs ────────────────────────────────────────────────
    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto  https;  # Toujours "https" (on termine SSL ici)

    # ── Health check (sans log, sans rate limit) ──────────────────────────────
    location = /api/health/ {
        proxy_pass http://backend;
        access_log off;
    }

    # ── Auth endpoints (rate limit strict anti-brute-force) ───────────────────
    # DOIT être AVANT /api/ pour avoir la priorité (location plus spécifique)
    location /api/auth/ {
        limit_req        zone=api_auth burst=5 nodelay;
        limit_req_status 429;

        proxy_pass       http://backend;
        proxy_pass_header Set-Cookie;
        # Force Secure + HttpOnly + SameSite=Strict sur les cookies JWT
        proxy_cookie_flags ~ httponly samesite=strict secure;
    }

    # ── API Django générale (rate limit global) ────────────────────────────────
    location /api/ {
        limit_req        zone=api_global burst=20 nodelay;
        limit_req_status 429;

        proxy_pass       http://backend;
        proxy_pass_header Set-Cookie;
        proxy_cookie_flags ~ httponly samesite=strict secure;
    }

    # ── Django Admin — accès restreint par IP ──────────────────────────────────
    # SÉCURITÉ : l'admin Django ne doit pas être public. Ajouter les IPs
    # autorisées ci-dessous. En urgence : SSH tunnel (ssh -L 8000:localhost:8000)
    location /admin/ {
        allow 127.0.0.1;      # Accès local (SSH tunnel uniquement)
        # allow X.X.X.X;     # IP fixe bureau ou VPN — décommenter et adapter
        deny all;
        proxy_pass http://backend;
    }

    # ── Fichiers statiques Django (servis par WhiteNoise via Gunicorn) ─────────
    location /static/ {
        proxy_pass http://backend;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ── Assets statiques Next.js (_next/static/) ──────────────────────────────
    location /_next/static/ {
        proxy_pass http://frontend;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── Frontend Next.js (fallback pour toutes les autres routes) ─────────────
    location / {
        proxy_pass          http://frontend;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade    $http_upgrade;
        proxy_set_header    Connection "upgrade";
    }
}
